<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="25dp">
<TextView
    android:layout_marginTop="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Lista de Pessoas"
    android:textSize="26dp"
    android:textStyle="bold"
    android:gravity="left"
    android:paddingBottom="20dp"/>

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Digite o nome"
    android:textSize="20sp" />

<EditText
    android:id="@+id/txtnameEdit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:hint="Ex: Thiago Lopes"
    android:inputType="textPersonName"/>

<Button
    android:id="@+id/btnAdd"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Adicionar pessoa"/>

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Lista:"
    android:textSize="18sp"
    android:textStyle="bold"
    android:paddingTop="20dp"
    android:paddingBottom="8dp"/>

<ListView
    android:id="@+id/LVpessoas"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:paddingBottom="20dp" />

<Button
    android:layout_marginBottom="25dp"
    android:id="@+id/removerButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Remover pessoa"/>


</LinearLayout>